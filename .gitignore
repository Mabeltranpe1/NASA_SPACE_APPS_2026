*:Zone.Identifier
.~lock.*#

# Reproducible small derived science products; native multi-GB inputs stay ignored.
!data/processed/earth/
!data/processed/mars/
!data/processed/moon/
!data/processed/earth/*_DEM_200m.tif
!data/processed/mars/*_DEM_200m.tif
!data/processed/moon/*_DEM_200m.tif
!data/raw/climate/
!data/raw/climate/*_NASA_POWER.csv
!data/raw/moon/
data/raw/moon/*
!data/raw/moon/README
!web/public/data/science/files/data/processed/
!web/public/data/science/files/data/processed/*/
!web/public/data/science/files/data/processed/*/*_DEM_200m.tif

