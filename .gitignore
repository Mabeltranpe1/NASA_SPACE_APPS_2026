# Datos (pesados, se descargan con scripts)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Formatos de datos geoespaciales/planetarios grandes
*.tif
*.tiff
*.img
*.IMG
*.nc
*.hdf
*.h5
*.zip
*.tar.gz

# Entornos locales (conda)
ambientes/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/

# Credenciales
.env
.netrc
*.key

# Editor / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archivos descartados (revisar y borrar a mano)
_to_delete/

# Bloqueos de LibreOffice
.~lock.*

# Region files of the worldwide grid search (2x2 degree areas, e.g. libya_24n_014e.csv).
# Too many to keep in git; rebuild them with outputs/grid_search/ scripts.
data/regions/*_[0-9][0-9][ns]_[0-9][0-9][0-9][ew].csv

# The Earth table lives compressed in data/earth_all.csv.gz; never commit an uncompressed copy.
data/earth_all.csv

# Intermediate files of the worldwide grid search (src/grid_search/README.md)
outputs/grid_search/cells.parquet
outputs/grid_search/tiles.csv
outputs/grid_search/grid_catalog_rows.csv
outputs/grid_search/ne/
